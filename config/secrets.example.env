# 本地密钥模板：复制为 config/secrets.env 后填入真实值
# 该文件仅用于本机运行，config/secrets.env 已在 .gitignore 中忽略
# 不要把真实 Key 提交到仓库

# ===== 对话 / 出题 / 评分 / Agent（DeepSeek） =====
DEEPSEEK_API_KEY=sk-请替换为DeepSeekKey
APP_AI_PROVIDER=openai
APP_AI_BASE_URL=https://api.deepseek.com/v1
APP_AI_MODEL=deepseek-chat

# ===== 语音转写（硅基流动） =====
APP_ASR_PROVIDER=openai
APP_ASR_BASE_URL=https://api.siliconflow.cn/v1
APP_ASR_API_KEY=sk-请替换为硅基流动Key
APP_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ===== RAG Embedding（硅基流动） =====
APP_EMBEDDING_PROVIDER=openai
APP_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
APP_EMBEDDING_API_KEY=sk-请替换为硅基流动Key
APP_EMBEDDING_MODEL=BAAI/bge-m3

# ===== 可选：JWT 密钥（生产必须改） =====
# APP_JWT_SECRET=请替换为至少32位随机字符串
