# 部署环境变量模板：复制为 deploy/.env 后填写真实值
# 该文件包含密钥，已在 .gitignore 中忽略，不要提交

# ===== 域名与证书 =====
# 你的域名（nginx 与证书路径按它配置）
APP_DOMAIN=interview.example.com

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=请替换为强密码
MYSQL_DATABASE=ai_interview
DB_USER=root
DB_PASSWORD=请替换为强密码

# ===== Redis =====
REDIS_PASSWORD=请替换为强密码

# ===== JWT（生产必须换，至少 32 位） =====
APP_JWT_SECRET=请替换为至少32位随机字符串

# ===== 对话 / Agent（DeepSeek） =====
DEEPSEEK_API_KEY=sk-你的DeepSeekKey
APP_AI_PROVIDER=openai
APP_AI_BASE_URL=https://api.deepseek.com/v1
APP_AI_MODEL=deepseek-chat

# ===== 语音转写（硅基流动） =====
APP_ASR_PROVIDER=openai
APP_ASR_BASE_URL=https://api.siliconflow.cn/v1
APP_ASR_API_KEY=sk-你的硅基流动Key
APP_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# ===== 向量检索（硅基流动） =====
APP_EMBEDDING_PROVIDER=openai
APP_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
APP_EMBEDDING_API_KEY=sk-你的硅基流动Key
APP_EMBEDDING_MODEL=BAAI/bge-m3

# ===== 语音合成（可选：none / openai / volcengine） =====
APP_TTS_PROVIDER=none

# ===== ICE（WebRTC）：TURN 用带账号密码的 URL =====
# 示例：turn:user:pass@turn.example.com:3478
APP_ICE_SERVERS=stun:stun.l.google.com:19302

# ===== 首次启动：灌入演示账号（admin/interviewer/candidate，密码 123456） =====
# 建好正式账号后改成 false 并重启
APP_DEMO_DATA_ENABLED=true
